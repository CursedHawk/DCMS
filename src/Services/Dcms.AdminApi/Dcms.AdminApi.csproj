<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="DnsClient" />
    <PackageReference Include="JsonSchema.Net" />
    <!-- SignalR backplane for the notification hub, so a consumer on one replica reaches a
         browser connected to another. Version is pinned centrally in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <!-- The release catch-up (BUG-01) is an internal tail on a notification consumer; the
       integration test drives it directly rather than racing a JetStream delivery. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Dcms.IntegrationTests" />
  </ItemGroup>

  <!-- Vendor the @dcms/api-client runtime source into the downloadable client zip. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\packages\api-client\src\index.ts" LogicalName="Dcms.AdminApi.ApiClientGen.Runtime.index.ts" />
    <EmbeddedResource Include="..\..\..\packages\api-client\src\types.ts" LogicalName="Dcms.AdminApi.ApiClientGen.Runtime.types.ts" />
  </ItemGroup>

  <!-- Embed the Mode B starter templates (see ApiClientGen/SiteTemplates.cs). Targeted globs
       avoid walking node_modules. shared/src/api/ is a typecheck fixture of generated output and
       is never shipped - each tenant's own generated layer takes its place. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\packages\site-template-react\shared\**\*" Exclude="..\..\..\packages\site-template-react\shared\src\api\**">
      <LogicalName>Dcms.AdminApi.SiteTemplates/shared/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\packages\site-template-react\templates\**\*">
      <LogicalName>Dcms.AdminApi.SiteTemplates/templates/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(DcmsSrcRoot)PluginSdk\Dcms.PluginSdk.Abstractions\Dcms.PluginSdk.Abstractions.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Plugins\Dcms.Plugins.All\Dcms.Plugins.All.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Caching\Dcms.Shared.Caching.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Data\Dcms.Shared.Data.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Media\Dcms.Shared.Media.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Hosting\Dcms.Shared.Hosting.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Messaging\Dcms.Shared.Messaging.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Security\Dcms.Shared.Security.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Storage\Dcms.Shared.Storage.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Shared\Dcms.Shared.Vault\Dcms.Shared.Vault.csproj" />
  </ItemGroup>

</Project>
