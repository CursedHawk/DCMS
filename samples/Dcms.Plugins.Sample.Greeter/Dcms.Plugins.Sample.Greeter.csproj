<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plugin built the way an outside developer builds one: against the SDK abstractions and
    the .Api assemblies of the plugins it integrates with — nothing else of DCMS. Outside this
    repository those are PackageReferences (Dcms.PluginSdk.Abstractions, Dcms.Plugins.Blog.Api,
    Dcms.Plugins.Forms.Api from the GitLab package registry); here they are project references.

    Install: dotnet publish -c Release -o <Plugins:Directory>/Dcms.Plugins.Sample.Greeter
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(DcmsSrcRoot)PluginSdk\Dcms.PluginSdk.Abstractions\Dcms.PluginSdk.Abstractions.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Plugins\Dcms.Plugins.Blog.Api\Dcms.Plugins.Blog.Api.csproj" />
    <ProjectReference Include="$(DcmsSrcRoot)Plugins\Dcms.Plugins.Forms.Api\Dcms.Plugins.Forms.Api.csproj" />
  </ItemGroup>

</Project>
