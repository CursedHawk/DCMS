# ---------------------------------------------------------------------------
# DCMS deployment environment file.
#
# Copy to `.env` in the repo root on the target host and fill in every value:
#
#     cp .env.example .env && chmod 600 .env
#
# Compose reads this for ${VAR} substitution across docker-compose.yml,
# docker-compose.prod.yml and docker-compose.vps.yml. It is gitignored and
# excluded from the Docker build context (.dockerignore) so it can never enter
# an image layer.
#
# Generate every secret with:  openssl rand -base64 36
#
# NOTE ON DIRECTION OF TRAVEL: this file is the current source of truth, but it
# is being retired. Vault becomes the source of truth for configuration and
# secrets; a Vault Agent on each node renders the values that infrastructure
# containers (postgres, minio, nats, grafana, forgejo, caddy) need, because
# those cannot read Vault themselves. Once that lands, this file shrinks to
# VAULT_ADDR, DCMS_ENV and COMPOSE_PROJECT_NAME. Do not add new secrets here.
# ---------------------------------------------------------------------------


# --- Which deployment this is ----------------------------------------------

# Not secrets. dev and prod run the same images and the same config files, so
# these two are what tell them apart in telemetry.
#
# They become Prometheus `external_labels`, which are stamped onto every series
# this stack stores and onto every alert it fires. Getting them wrong is worse
# than leaving them unset: an undefined variable expands to an EMPTY label, but
# a prod stack labelled `dev` produces alerts that name the wrong box while
# looking entirely plausible. Compose falls back to `unknown` for that reason.
#
#   DCMS_ENV   dev | prod   — also read by scripts/deploy.sh to pick the overlay set
#   DCMS_HOST  the host's short name, e.g. vps1
DCMS_ENV=
DCMS_HOST=


# --- Datastores ------------------------------------------------------------

# Superuser password for the `dcms` Postgres role that every service connects
# as. Used by the postgres container itself and by the init scripts.
POSTGRES_PASSWORD=

# Least-privilege role for site-builder: USAGE on the `sites` schema only.
SITEBUILDER_DB_PASSWORD=

# The read-only role the RLS isolation tests connect as. It has SELECT on every
# tenant schema and no BYPASSRLS, so it sees only rows matching the app.tenant_id
# setting.
#
# SET THIS. infra/postgres/init/01-rls.sql creates the role with a password
# hardcoded in this repository, because initdb cannot be passed a parameter. The
# postgres-bootstrap job converges it to this value on every deploy; leaving it
# empty leaves a role with SELECT on all tenant data on a published password.
RLS_DB_PASSWORD=

MINIO_ROOT_USER=dcms
MINIO_ROOT_PASSWORD=

# Scoped MinIO service account for site-builder, created by infra/minio/init.sh
# (again: fresh volume only). It cannot read the media bucket, which is why
# Storage__HealthBucket exists as a separate probe target.
SITEBUILDER_MINIO_USER=dcms-sitebuilder
SITEBUILDER_MINIO_PASSWORD=

# NATS accounts. Both use the ${VAR:?} form in compose, so an unset value fails
# the whole invocation rather than starting a server nobody can authenticate
# against. NATS_APP_PASSWORD belongs to the $G user that services are mapped to
# via `no_auth_user: app`; NATS_SYS_PASSWORD is the $SYS account nats-surveyor
# collects as.
NATS_APP_PASSWORD=
NATS_SYS_PASSWORD=


# --- Vault -----------------------------------------------------------------

# LEGACY, and on its way out. One token shared by every service, with read on
# secret/data/dcms/*. Two problems, both of which have bitten this deployment:
# it expires (nothing renews a periodic token, and the failure is invisible until
# the next restart), and it gives every container every secret the platform holds.
#
# Prefer the per-service AppRoles below. A service falls back to this token only
# when its VAULT_ROLE_ID/VAULT_SECRET_ID pair is unset, which is what lets the
# migration happen one service at a time.
VAULT_TOKEN=

# --- Vault AppRole credentials (per service) -------------------------------
#
# Each service logs in itself and receives a short-lived token scoped by
# infra/vault/policies/dcms-<service>.hcl to secret/dcms/shared plus its own path.
# Nothing to renew, and no shared blast radius.
#
# Provision the roles once:
#   VAULT_ADDR=... VAULT_TOKEN=<admin> infra/vault/apply.sh
#
# Then per service:
#   vault read  -field=role_id      auth/approle/role/dcms-<service>/role-id
#   vault write -f -field=secret_id auth/approle/role/dcms-<service>/secret-id
#
# The secret id IS a credential. This file only (chmod 600), never git.
VAULT_ROLE_ID_IDENTITY=
VAULT_SECRET_ID_IDENTITY=
VAULT_ROLE_ID_ADMIN_API=
VAULT_SECRET_ID_ADMIN_API=
VAULT_ROLE_ID_CONTENT_API=
VAULT_SECRET_ID_CONTENT_API=
VAULT_ROLE_ID_MEDIA_WORKER=
VAULT_SECRET_ID_MEDIA_WORKER=
VAULT_ROLE_ID_SITE_BUILDER=
VAULT_SECRET_ID_SITE_BUILDER=
VAULT_ROLE_ID_SITE_HOST=
VAULT_SECRET_ID_SITE_HOST=
VAULT_ROLE_ID_AI_GATEWAY=
VAULT_SECRET_ID_AI_GATEWAY=

# Transit auto-unseal. Token for the seal Vault on VPSM that holds this Vault's unseal
# key; read by the seal stanza in infra/vault/server/seal-transit.hcl.
#
# Without auto-unseal a reboot leaves Vault SEALED and the whole platform down
# until a human runs `vault operator unseal` three times -- which is precisely
# when the dashboards that would tell them are also down. See
# infra/vault/server/seal-transit.hcl.example for the trade this makes.
VAULT_TRANSIT_SEAL_TOKEN=


# --- Identity and service-to-service auth ----------------------------------

# Public base URL of the identity/admin plane. Becomes the OIDC token issuer,
# so changing it invalidates every live token.
PUBLIC_BASE_URL=https://admin.example.com

# The same three public names in the bare-hostname form Caddy needs for a site
# address, and Forgejo for its clone URLs. dev and prod deploy the SAME Caddyfile,
# the same grafana.ini and the same compose overlays -- these are what make one
# artifact serve two environments instead of the dev edge requesting a certificate
# for production's hostname.
#
# Defaults (used when left empty) are production's names, so an existing prod host
# needs no change. A dev host sets all four.
#
#   ADMIN_HOST      must equal PUBLIC_BASE_URL without the scheme.
#                   scripts/deploy.sh refuses to deploy if the two disagree --
#                   an edge and an issuer that disagree about the host's own name
#                   produce a login loop, not an error message.
ADMIN_HOST=admin.example.com
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_ROOT_URL=https://grafana.example.com/
GIT_HOST=git.example.com

# Confidential client secret for admin-api -> ai-gateway (client_credentials).
# Must match the value identity seeds for the dcms-admin-api-service client.
ADMIN_API_CLIENT_SECRET=

# Platform SuperAdmin, seeded by identity on first boot.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# Google SSO. Both must be non-blank or the Google provider is not wired up at
# all -- leaving them empty disables Google login rather than breaking startup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenIddict signing and encryption certificates, base64-encoded PKCS#12 (.pfx).
#
# REQUIRED IN PRODUCTION. Without them OpenIddict mints keys into a per-container
# store, which means (a) every replica publishes a different JWKS, so a token minted
# by one is rejected by the others -- identity cannot be scaled past one replica --
# and (b) recreating the container invalidates every live token, so every deploy
# force-logs-out every user.
#
#   openssl req -x509 -newkey rsa:2048 -sha256 -days 1825 -nodes \
#     -keyout signing.key -out signing.crt -subj "/CN=DCMS Identity Signing"
#   openssl pkcs12 -export -out signing.pfx -inkey signing.key -in signing.crt -passout pass:
#   base64 -w0 signing.pfx
#
# Repeat for the encryption certificate. Rotating the signing certificate invalidates
# every token signed with the old one.
IDENTITY_SIGNING_CERTIFICATE=
IDENTITY_ENCRYPTION_CERTIFICATE=
# Only if the .pfx files carry an export password.
IDENTITY_CERTIFICATE_PASSWORD=

# Escape hatch for the rollout: accept per-container keys and their two consequences
# above. Identity refuses to start in Production without certificates unless this is
# true. It is not a setting to leave on.
IDENTITY_ALLOW_EPHEMERAL_KEYS=false


# --- Audit -----------------------------------------------------------------

# HMAC key for the audit hash chain. Base64, at least 32 bytes.
#
# NEVER ROTATE THIS. The chain is verified from the beginning; a new key breaks
# verification of every record written under the old one. Outside Development a
# missing or short value refuses to start.
AUDIT_CHAIN_KEY=


# --- Git backend (Forgejo) -------------------------------------------------

# Machine token used by admin-api for repo and org operations.
FORGEJO_TOKEN=

# Token with write:admin, used by identity to mirror DCMS users into Forgejo.
FORGEJO_ADMIN_TOKEN=

# Gates the anonymous build-on-push webhook route. admin-api REFUSES TO START
# in Production if this is empty or one of the known weak defaults (including
# "dcms-forgejo-webhook", which docker-compose.vps.yml uses as its fallback).
# Changing it requires re-registering the site webhooks.
FORGEJO_WEBHOOK_SECRET=


# --- Email -----------------------------------------------------------------

# SMTP relay. email-worker is the SOLE holder of these credentials -- nothing on
# a request path speaks SMTP; everything goes through the EMAIL JetStream queue.
#
# FROM_ADDRESS must be an address the relay's provider actually owns, or
# delivery is silently rejected downstream.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_STARTTLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DCMS


# --- Edge ------------------------------------------------------------------

# Let's Encrypt account email for Caddy, including on-demand TLS for tenant
# custom domains.
ACME_EMAIL=ops@example.com


# --- Observability ---------------------------------------------------------

# Break-glass local Grafana login, for when identity is the thing that is down.
GRAFANA_ADMIN_PASSWORD=

# Must equal Identity__Grafana__Secret -- the same value is read by both the
# grafana and identity containers.
GRAFANA_OIDC_CLIENT_SECRET=

# The dcms_grafana Postgres role: read-only, USAGE on the `obs` schema and
# nothing else. Created manually on an existing cluster.
GRAFANA_DB_USER=dcms_grafana
GRAFANA_DB_PASSWORD=


# Bearer token for Grafana's webhook contact point -> POST /api/internal/alerts.
# Read by TWO containers (grafana sends it, admin-api compares it); a mismatch
# rejects every alert, which looks exactly like having nothing to alert about.
# Must be >= 16 characters and not a known default or admin-api refuses to
# start in Production. Leaving it unset is allowed and fails closed.
ALERT_WEBHOOK_SECRET=

# Comma-separated. Defaults to SUPERADMIN_EMAIL when unset.
ALERT_RECIPIENTS=


# --- Build sandbox ---------------------------------------------------------

# Container runtime site-builder invokes for Mode B tenant builds. The work
# directory it bind-mounts is a HOST path, resolved by the shared daemon, which
# is why site-builder replicas are pinned to a node that has both.
DCMS_BUILD_RUNTIME=docker
