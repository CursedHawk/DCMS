          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "xField": "tenant_slug"
      },
      "fieldConfig": {
        "defaults": {
