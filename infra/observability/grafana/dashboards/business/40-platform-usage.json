    {
      "id": 7,
      "type": "timeseries",
      "title": "Growth",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT day AS time, new_tenants, new_users, new_sites, new_content\nFROM obs.v_growth_daily\nWHERE day >= now() - interval '180 days'\nORDER BY day\n",
          "rawQuery": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Tenant inventory",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT\n    tenant_slug, tenant_name, status, created_at,\n    members, sites, verified_domains, content_items, published_items,\n    media_assets, enabled_plugins, visitor_accounts, form_submissions\nFROM obs.v_tenant_inventory\nORDER BY created_at DESC\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "description": "Everything each tenant has, counted from the tables that hold it.",
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Storage by tenant",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT tenant_slug, original_bytes, variant_bytes\nFROM obs.v_storage_usage\nWHERE total_bytes > 0\nORDER BY total_bytes DESC\nLIMIT 20\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "description": "Originals and generated variants counted apart, because 'why is this tenant using 4 GB' is usually answered by the variant ladder rather than by what anyone uploaded.",
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "xField": "tenant_slug"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Members by tenant",
      "datasource": {
