    {
      "id": 23,
      "type": "table",
      "title": "Their site builds",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT created_at AS \"time\", site_name, render_mode, status, from_git,\n       round(duration_seconds::numeric, 1) AS duration_s\nFROM obs.v_site_builds\nWHERE tenant_slug = '$tenant'\nORDER BY created_at DESC LIMIT 50\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
