          "rawSql": "\nSELECT day AS time, sum(visitors) AS visitors, sum(sessions) AS sessions, sum(events) AS events\nFROM obs.v_visitor_demographics\nWHERE tenant_slug = '$tenant'\nGROUP BY day ORDER BY day\n",
