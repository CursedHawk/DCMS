      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT occurred_at AS \"time\", action, outcome, actor_kind, actor_display,\n       resource_type, resource_label, service, trace_id\nFROM obs.v_audit_recent\nWHERE tenant_slug = '$tenant' AND occurred_at >= now() - interval '30 days'\nORDER BY occurred_at DESC LIMIT 200\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
