    {
      "id": 51,
      "type": "table",
      "title": "Most visited paths (from the daily rollups)",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT tenant_slug, path, event_type, sum(events) AS events\nFROM obs.v_visitor_traffic_daily\nWHERE day >= (now() - interval '30 days')::date\nGROUP BY tenant_slug, path, event_type\nORDER BY events DESC LIMIT 50\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "description": "Reads the pre-aggregated rollups, which is why this still answers questions about last year: raw events are kept 90 days, rollups indefinitely.",
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
