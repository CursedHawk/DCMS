    {
      "id": 43,
      "type": "stat",
      "title": "Mobile share (30d)",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
