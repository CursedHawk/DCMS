      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT round(100.0 * sum(events) FILTER (WHERE device = 'mobile') / clamp_min(sum(events), 1), 1) AS value\nFROM obs.v_visitor_demographics WHERE day >= now() - interval '30 days'\n",
          "rawQuery": true,
          "refId": "A",
