            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT country, sum(events) AS events FROM obs.v_visitor_demographics\nWHERE day >= now() - interval '30 days' AND country <> 'unknown'\nGROUP BY country ORDER BY events DESC LIMIT 20\n",
