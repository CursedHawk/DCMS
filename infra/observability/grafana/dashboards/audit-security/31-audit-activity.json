      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Recent actions \u2014 click a trace id to open its trace",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT\n    occurred_at AS \"time\",\n    tenant_slug,\n    action,\n    outcome,\n    actor_kind,\n    actor_display,\n    resource_type,\n    resource_label,\n    service,\n    status_code,\n    trace_id\nFROM obs.v_audit_recent\nWHERE occurred_at >= now() - interval '7 days'\n  AND ($action = '' OR action LIKE $action || '%')\nORDER BY occurred_at DESC\nLIMIT 200\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "description": "trace_id is the join to Tempo. It is stored on every audit record and kept for 400 days, long after the span tree itself expires at 7.",
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      }
    }
