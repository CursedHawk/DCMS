            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT day AS time, outcome, sum(events) AS events\nFROM obs.v_tenant_activity_daily\nWHERE day >= now() - interval '30 days'\nGROUP BY day, outcome\nORDER BY day\n",
          "rawQuery": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
