    {
      "id": 21,
      "type": "barchart",
      "title": "Most frequent actions (30 days)",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT action, sum(events) AS events\nFROM obs.v_tenant_activity_daily\nWHERE day >= now() - interval '30 days'\nGROUP BY action\nORDER BY events DESC\nLIMIT 25\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "xField": "action"
