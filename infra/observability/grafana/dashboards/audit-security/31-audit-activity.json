            "fillOpacity": 80,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "piechart",
      "title": "Actions by actor kind (30 days)",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT actor_kind, count(*) AS events\nFROM obs.v_audit_recent\nWHERE occurred_at >= now() - interval '30 days'\nGROUP BY actor_kind\nORDER BY events DESC\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
