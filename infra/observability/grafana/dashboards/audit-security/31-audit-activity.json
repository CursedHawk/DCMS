    {
      "id": 19,
      "type": "timeseries",
      "title": "Actions per day by category",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT day AS time, category, sum(events) AS events\nFROM obs.v_tenant_activity_daily\nWHERE day >= now() - interval '30 days'\nGROUP BY day, category\nORDER BY day\n",
          "rawQuery": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
