    {
      "id": 32,
      "type": "table",
      "title": "Security records",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT\n    occurred_at AS \"time\",\n    tenant_slug, action, outcome, actor_kind, actor_display,\n    service, route, status_code, trace_id\nFROM obs.v_audit_recent\nWHERE occurred_at >= now() - interval '7 days'\n  AND (category = 'Security' OR outcome IN ('Denied','Failure'))\nORDER BY occurred_at DESC\nLIMIT 200\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
