          "rawSql": "\nSELECT date_trunc('hour', occurred_at) AS time, action, count(*) AS events\nFROM obs.v_audit_recent\nWHERE occurred_at >= now() - interval '7 days' AND category = 'Security'\nGROUP BY 1, 2 ORDER BY 1\n",
