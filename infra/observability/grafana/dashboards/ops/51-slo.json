{
  "uid": "dcms-slo",
  "title": "SLO & error budget",
  "description": "Availability and latency against target, with error-budget burn rate.",
  "tags": [
    "dcms",
    "ops",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 19,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Availability and latency against a stated target, with the error budget that follows from it.**\n\nTargets: 99.5% availability and p95 under 500 ms over 30 days. 99.5% is about 3.6 hours a month \u2014 an honest number for a single host with no swap, one Postgres, and a Vault that must be unsealed by hand after a reboot. Setting it higher would not make the platform more available; it would make the budget panel red permanently and therefore ignored."
      }
    },
    {
      "id": 20,
      "type": "gauge",
      "title": "30-day availability",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_request_duration_seconds_count[30d])), 1))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "avail"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.98,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "gauge",
      "title": "Error budget remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "clamp_min(1 - ((sum(increase(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_request_duration_seconds_count[30d])), 1)) / 0.005), 0)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "budget"
        }
      ],
      "description": "How much of the month's allowed 0.5% error rate is left. Zero does not mean an outage \u2014 it means the next one is not budgeted for.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Requests in window",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum(increase(http_server_request_duration_seconds_count[30d]))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "n"
        }
      ],
      "description": "Read the availability figure against this. A 99% availability over 200 requests is two failures, not an outage.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "p95 over 30 days",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[30d])))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Availability by service",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "1 - (dcms:http_error_ratio:rate5m)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Error budget burn rate",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "dcms:http_error_ratio:rate5m / 0.005",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{service}}"
        }
      ],
      "description": "Multiples of the sustainable rate. A burn rate of 1 exhausts the month's budget in exactly a month; 14 exhausts it in two days.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 26,
