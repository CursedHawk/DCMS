          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum(container_memory_working_set_bytes{name=~\"dcms-(grafana|prometheus|loki|tempo|alloy|nats-exporter|nats-surveyor|docker-socket-proxy-ro)-.*\"})",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "obs"
        }
      ],
      "description": "What this stack costs the host it observes. Budgeted at roughly 2.1 GB of hard limits.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
