        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "container_memory_working_set_bytes{name=~\"dcms-.*\"} / container_spec_memory_limit_bytes{name=~\"dcms-.*\"} > 0",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{name}}"
        }
      ],
      "description": "Only containers that actually have a limit appear. Anything approaching 1.0 here is about to be killed.",
      "options": {
        "legend": {
          "displayMode": "table",
