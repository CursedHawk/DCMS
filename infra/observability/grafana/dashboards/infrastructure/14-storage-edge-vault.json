    {
      "id": 44,
      "type": "stat",
      "title": "Failing",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum(dcms_edge_certificates{state=\"failing\"}) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "failing"
        }
      ],
      "description": "Hostnames whose last issuance attempt failed and are inside the backoff. Usually a tenant's DNS record that was removed after verification -- edge.certificates keeps the CA's own sentence in LastError, which is the half Caddy logged once and discarded. Anything non-zero for more than a day is worth chasing: failed authorizations count against the same Let's Encrypt budget as successful ones.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
