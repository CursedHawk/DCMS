          "refId": "A",
          "format": "time_series",
          "legendFormat": "evicted"
        }
      ],
      "description": "Non-zero means Redis is discarding cache entries under memory pressure, which shows up downstream as unexplained cache misses.",
      "options": {
        "reduceOptions": {
          "calcs": [
