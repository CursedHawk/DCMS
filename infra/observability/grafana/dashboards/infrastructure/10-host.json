      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "dcms:host_disk_seconds_to_full > 0",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "eta"
        }
      ],
      "description": "Extrapolated from the last six hours of free space. Empty means the disk is not filling. This is the panel that turns '46% full' into a date.",
