    {
      "id": 36,
      "type": "table",
      "title": "Largest tables",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT\n    n.nspname                                          AS schema,\n    c.relname                                          AS \"table\",\n    pg_total_relation_size(c.oid)                      AS total_bytes,\n    pg_relation_size(c.oid)                            AS heap_bytes,\n    pg_indexes_size(c.oid)                             AS index_bytes,\n    c.reltuples::bigint                                AS approx_rows\nFROM pg_class c\nJOIN pg_namespace n ON n.oid = c.relnamespace\nWHERE c.relkind IN ('r','p')\n  AND n.nspname NOT IN ('pg_catalog','information_schema')\nORDER BY pg_total_relation_size(c.oid) DESC\nLIMIT 30\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "description": "Includes the audit_events monthly partitions, which is usually what grows fastest.",
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 37,
      "type": "table",
      "title": "Slowest statements (pg_stat_statements)",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT\n    calls,\n    round(total_exec_time::numeric, 1)   AS total_ms,\n    round(mean_exec_time::numeric, 2)    AS mean_ms,\n    rows,\n    left(query, 240)                     AS query\nFROM pg_stat_statements\nORDER BY total_exec_time DESC\nLIMIT 30\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "description": "Ordered by total time, not mean: a fast query run a million times costs more than a slow one run twice. Requires shared_preload_libraries=pg_stat_statements, set on the postgres command line in docker-compose.prod.yml.",
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      }
    },
