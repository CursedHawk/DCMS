{
  "uid": "dcms-site-builds",
  "title": "Site builds",
  "description": "Build throughput, duration by render mode, failures and the sandbox.",
  "tags": [
    "dcms",
    "application",
    "sites"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 22,
      "type": "stat",
      "title": "Builds (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum(increase(dcms_site_build_total[24h]))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "n"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Failed (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "(sum(increase(dcms_site_build_total{outcome=\"failure\"}[24h]))) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "fail"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "p95 duration",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dcms_site_build_duration_seconds_bucket[6h])))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "p95"
        }
      ],
      "description": "Mode B builds run npm install and vite build in an ephemeral sandbox container, so they are minutes, not seconds.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [],
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "type": "stat",
      "title": "SITES queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum(jetstream_consumer_num_pending{stream_name=\"SITES\"})",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "pending"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Across every build lane. site-builder drains git-backed publishes (site-builder-git) separately from static-bundle ones (site-builder-static) so an expensive React build cannot sit in front of a cheap extract \u2014 which one is backed up is the panel below."
    },
    {
      "id": 26,
      "type": "stat",
      "title": "site-builder memory",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "max(container_memory_working_set_bytes{name=~\"dcms-site-builder.*\"})",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "mem"
        }
      ],
      "description": "Limited to 2 GB in compose.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [],
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Build sandboxes running",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "count(container_last_seen{name=~\".*site-build-sandbox.*\"}) or vector(0)",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "n"
        }
      ],
      "description": "Each untrusted build runs in its own ephemeral container with no network and a scrubbed environment.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Queue depth by lane",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum by (consumer_name) (jetstream_consumer_num_pending{stream_name=\"SITES\"})",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{consumer_name}}"
        }
      ],
      "description": "site-builder-git carries Modes A and B, site-builder-static carries Mode C, and they drain independently. Before the split all three shared one consumer, and because JetStream delivers in order a 340 ms bundle extract behind a running 30 s React build had a p95 of 34.8 seconds. A rising git lane beside a flat static lane is this working; both rising together means the host is short of capacity rather than the queue being mis-shaped. site-builder is the legacy pre-split lane and should stay at zero.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Builds by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum by (outcome) (rate(dcms_site_build_total[1h])) * 3600",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Build duration p95 by mode",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (mode, le) (rate(dcms_site_build_duration_seconds_bucket[1h])))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{mode}}"
        }
      ],
      "description": "Mode A prerenders HTML/CSS in C#; Mode B builds a React app in a sandbox. They are not comparable and should not share a threshold.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "table",
      "title": "Recent builds",
      "datasource": {
        "type": "postgres",
        "uid": "dcms-postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dcms-postgres"
          },
          "rawSql": "\nSELECT\n    created_at   AS \"time\",\n    tenant_slug,\n    site_name,\n    render_mode,\n    status,\n    from_git,\n    round(duration_seconds::numeric, 1) AS duration_s\nFROM obs.v_site_builds\nWHERE created_at > now() - interval '7 days'\nORDER BY created_at DESC\nLIMIT 100\n",
          "rawQuery": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 31,
      "type": "logs",
      "title": "site-builder log",
      "datasource": {
        "type": "loki",
        "uid": "dcms-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "dcms-loki"
          },
          "expr": "{service=\"site-builder\"} | detected_level =~ \"error|warn\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
