      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum(rate(dcms_email_sent_total[15m])) * 900",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "sent"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum by (reason) (rate(dcms_email_failed_total[15m])) * 900",
          "refId": "B",
          "format": "time_series",
          "legendFormat": "failed {{reason}}"
        }
      ],
      "description": "Failure reasons are bounded classes, never the relay's message. The relay in use rejects any envelope sender it does not own, which surfaces here as a permanent rejection rather than a retry.",
