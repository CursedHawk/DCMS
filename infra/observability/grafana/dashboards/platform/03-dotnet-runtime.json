    {
      "id": 49,
      "type": "timeseries",
      "title": "Time to open a new pooled connection",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service, le) (max by (service, le, pool_name) (rate(db_client_connection_npgsql_create_time_seconds_bucket[5m]))))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{service}} p95"
        }
      ],
      "description": "Npgsql opens a physical connection only when the pool has none free, so a rising p95 here means the pool is the bottleneck, not the database.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
