{
  "uid": "dcms-dotnet-runtime",
  "title": ".NET runtime",
  "description": "GC, heap, thread pool, exceptions and connection pools across all eight services.",
  "tags": [
    "dcms",
    "platform",
    "runtime"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
