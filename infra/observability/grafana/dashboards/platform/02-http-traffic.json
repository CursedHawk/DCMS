          "expr": "dcms:tenant_publishes:rate1h * 3600",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "publishes {{tenant_id}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "dcms:tenant_builds:rate1h * 3600",
          "refId": "B",
          "format": "time_series",
          "legendFormat": "builds {{tenant_id}}"
        }
      ],
      "description": "Per-request traffic is deliberately NOT broken down by tenant here — that would multiply every route and status series by the tenant count. Ask Business → Tenant explorer instead; it reads Postgres, which holds cardinality without keeping it resident.",
