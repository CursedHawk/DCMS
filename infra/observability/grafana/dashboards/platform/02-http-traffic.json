    {
      "id": 40,
      "type": "timeseries",
      "title": "Per-tenant work (low-frequency counters only)",
      "datasource": {
        "type": "prometheus",
        "uid": "dcms-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
