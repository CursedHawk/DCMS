      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcms-prometheus"
          },
          "expr": "sum by (http_response_status_code) (dcms:http_requests:by_route:rate5m{service=~\"$service\"})",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
