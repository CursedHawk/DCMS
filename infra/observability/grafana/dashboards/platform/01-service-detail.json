    {
      "id": 27,
      "type": "logs",
      "title": "Errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "dcms-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "dcms-loki"
          },
          "expr": "{service=~\"$service\"} | detected_level =~ \"error|warn\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "description": "Every line carries a trace id. Click one to open its trace in Tempo.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
