# Production edge for tenant custom domains. Caddy terminates TLS and reverse-
# proxies everything to site-host, which resolves the Host header to a tenant's
# active site build (and proxies /api + /hub on to content-api internally).
#
# On-demand TLS issues a certificate the first time a hostname is requested, but
# ONLY after the `ask` endpoint approves it. site-host exposes
# GET /internal/tls-allowed?domain=<host> returning 200 for verified+linked
# domains and 404 otherwise, so Caddy never mints certs for unverified hosts.

{
	# Email for the ACME account (Let's Encrypt). Override via env in compose.
	email {$ACME_EMAIL:admin@example.com}

	on_demand_tls {
		ask http://site-host:8080/internal/tls-allowed
	}

	# Per-request HTTP metrics. Caddy 2.7 made these opt-in — without this the /metrics
	# listener below still answers, but it carries only Caddy's own admin and config
	# gauges, so caddy_http_requests_total and caddy_http_responses_total simply do not
	# exist and every edge panel on the storage/edge dashboard reads "No data". That is
	# indistinguishable from an edge serving no traffic, which is the failure this is
	# supposed to detect.
	#
	# The cost is a label set per host and per handler. On a platform whose edge routes a
	# bounded set of tenant domains that is small; if custom domains ever run to thousands,
	# revisit — the cardinality is in hostnames, not in paths.
	servers {
		metrics
	}
}

# Admin + identity plane. Normal ACME (this host's DNS must point here). The SPA
# is served at the root; identity and admin-api are reverse-proxied by path so
# the browser uses a single same-origin host for OIDC + API calls.
# The site addresses below come from the environment, with the production names as
# defaults. dev and prod deploy the SAME Caddyfile -- it is bind-mounted from the synced
# infra/ directory -- so a literal hostname here would make the dev edge request an ACME
# certificate for production's name and fail, repeatedly, against Let's Encrypt's rate limit.
# `{$VAR:default}` is Caddy's own env syntax, already used for ACME_EMAIL above.
# Authentication. Everything identity serves lives here now -- this block exists so the
# rollback documented on the caddy service in docker-compose.prod.yml stays viable: handing
# :80/:443 back to Caddy without it would leave auth.$DOMAIN unserved, and an unserved issuer
# is not a degraded platform, it is one nobody can sign in to. The @identity matcher below is
# kept for the same reason -- an older token or a cached SPA config still points at the admin
# host, and both paths answering is what makes the rollback survivable rather than a second
# outage.
{$AUTH_HOST:auth.highgeek.eu} {
	reverse_proxy identity:8080
}

{$ADMIN_HOST:admin.highgeek.eu} {
	# Identity-owned paths: OIDC discovery/JWKS, the connect/* protocol endpoints,
	# the interactive login UI, and the Google external-login callback
	# (/signin-google, the GoogleHandler's default CallbackPath). Matched
	# case-insensitively because ASP.NET routing is case-insensitive and the
	# cookie-auth challenge redirects to the capitalised "/Account/Login" while
	# the endpoints are mapped lowercase.
	@identity path_regexp (?i)^/(connect|account|signin-google|\.well-known)(/|$)
	handle @identity {
		reverse_proxy identity:8080
	}
	# Admin REST API.
	handle /api/* {
		reverse_proxy admin-api:8080
	}
	# Live-chat SignalR hub (hosted by content-api). Same-origin so the SPA's
	# negotiate + WebSocket avoid CORS; Caddy upgrades the WebSocket automatically.
	handle /hub/* {
		reverse_proxy content-api:8080
	}
	# Everything else is the static admin SPA (nginx does SPA fallback).
	handle {
		reverse_proxy admin-spa:80
	}
}

# Platform operations console. Same-origin with all three APIs it talks to, which is what
# lets it call them with no CORS anywhere — admin-api has none at all, and this is the
# established pattern on this stack.
#
# Order inside the block matters as much as the block's position: the two specific /api/
# prefixes must come before the general one, or admin-api would answer for all of them.
#
# This must be a NAMED site block above the on-demand-TLS catch-all at the bottom. Left to the
# catch-all, site-host's /internal/tls-allowed would correctly refuse to mint a certificate for
# a hostname no tenant has verified, and the console would simply never get TLS.
{$PLATFORM_HOST:platform.highgeek.eu} {
	# Identity-owned paths: OIDC discovery/JWKS, the connect/* protocol endpoints and the
	# interactive login UI. Matched case-insensitively for the same reason as the admin host.
	@identity path_regexp (?i)^/(connect|account|signin-google|\.well-known)(/|$)
	handle @identity {
		reverse_proxy identity:8080
	}
	# The console's own API: observability, ops, platform roles.
	handle /api/platform/* {
		reverse_proxy platform-api:8080
	}
	# The user directory, served by the service that owns users.
	handle /api/identity/* {
		reverse_proxy identity:8080
	}
	# Tenancy and the audit log, which admin-api already owns.
	handle /api/* {
		reverse_proxy admin-api:8080
	}
	# Everything else is the static console (nginx does SPA fallback).
	handle {
		reverse_proxy platform-spa:80
	}
}

# Observability. Grafana publishes no host port at all, so this block is the only way in
# from outside the compose network — and Grafana itself only admits platform SuperAdmins,
# via OIDC against identity (role_attribute_strict, so an unmatched user is refused rather
# than silently given Viewer).
#
# Note this must be a named site block, not a name under *.dcms.highgeek.eu. That wildcard
# already resolves and would fall through to the on-demand-TLS catch-all below, where
# site-host's /internal/tls-allowed would correctly refuse to mint a certificate for a
# hostname no tenant has verified.
{$GRAFANA_DOMAIN:grafana.highgeek.eu} {
	reverse_proxy grafana:3000
}

# Caddy's own metrics, on an internal-only listener that Alloy scrapes over the compose
# network. Deliberately NOT the admin API on :2019 — that endpoint can rewrite the running
# config, and reaching it from the compose network to get a scrape would trade a dashboard
# for a remote-reconfiguration primitive.
:2019 {
	metrics /metrics
}

# Git server (Forgejo) web UI + HTTP git transport. Normal ACME (this host's DNS
# must point here). SSH git access is separate, on host port 2222. Large pushes
# need a generous body limit; Caddy streams git's chunked responses fine.
{$GIT_HOST:git.highgeek.eu} {
	reverse_proxy forgejo:3000
}

# Catch-all site: any other hostname (tenant custom domains), certificate issued
# on demand once site-host approves it.
https:// {
	tls {
		on_demand
	}
	reverse_proxy site-host:8080
}
