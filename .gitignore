# .NET
bin/
obj/

# ...except the Vault CLI shim, which is a directory meant to go on PATH and is not build
# output. `bin/` above matches at any depth, so this file is invisible to git without the
# negation -- and it is referenced by infra/vault/apply.sh and docs/vault-secrets.md, so a
# silently unversioned copy would work on the box it was written on and nowhere else.
!infra/vault/bin/
!infra/vault/bin/vault
artifacts/
*.user
.vs/
TestResults/

# Node
node_modules/
# This is a pnpm workspace. A package-lock.json here is an npm artifact -- `npm init
# playwright` leaves one behind -- and committing it would give the repo two lockfiles
# disagreeing about the same dependency tree.
package-lock.json
dist/
.vite/
*.tsbuildinfo
coverage/

# Environment / secrets
# vault-init-secrets.txt holds the unseal key AND the root token. It lives on the
# deployed host next to the Vault data it protects, which is exactly why it must
# never be able to reach a working tree and from there a commit.
vault-init-secrets.txt
.env
.env.local
*.local.json
!appsettings.*.json

# IDE
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Playwright
tests/e2e/playwright-report/
tests/e2e/test-results/

#Graphify
graphify-out/

#Apps
apps/moordoor/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Deploy artifacts. The digest overlay is generated per pipeline run by
# scripts/ci/resolve-digests.sh, and .deploy/ is the target host's rollback state
# (the current and previous digest sets). Both are per-deployment facts, not source.
docker-compose.images.yml
.deploy/

# Load-test output (see loadtest/.gitignore for the detail)
loadtest/runs/
loadtest/fixtures/
