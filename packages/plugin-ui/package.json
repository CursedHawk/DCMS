{
  "name": "@dcms/plugin-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The SDK a DCMS plugin builds its admin screens with: the module contract, the host's services as hooks, and a Vite preset for plugins built outside this repository.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./src/shared.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@dcms/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-i18next": "^15",
    "@tanstack/react-query": "^5"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "jsdom": "^26",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^15",
    "i18next": "^25",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^4"
  }
}
