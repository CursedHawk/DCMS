{
  "name": "@dcms/site-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mode D component registry and runtime. Copied verbatim into every Mode D site (src/dcms/runtime/), so it imports nothing but its own files, react, react-dom, react-router, zod and dompurify.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "import": "./src/theme.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5",
    "vitest": "^4"
  }
}
