# Base URL of your tenant content API. Empty = same-origin (correct for the
# published site, where site-host proxies /api). For local dev against a remote
# tenant, set it to that host, e.g. https://acme.example.
VITE_API_BASE_URL=

# An instance slug + content type to list on the home page (see the API docs page
# in the admin for your tenant's slugs), e.g. VITE_DEMO_SLUG=news / _TYPE=post.
VITE_DEMO_SLUG=
VITE_DEMO_CONTENT_TYPE=
