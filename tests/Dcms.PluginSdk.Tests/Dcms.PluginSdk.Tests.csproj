    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PluginSdk\Dcms.PluginSdk.Runtime\Dcms.PluginSdk.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.All\Dcms.Plugins.All.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Articles\Dcms.Plugins.Articles.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.AudioLibrary\Dcms.Plugins.AudioLibrary.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Analytics\Dcms.Plugins.Analytics.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Blog\Dcms.Plugins.Blog.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Branding\Dcms.Plugins.Branding.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Carousel\Dcms.Plugins.Carousel.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Events\Dcms.Plugins.Events.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.FileDownloads\Dcms.Plugins.FileDownloads.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Forms\Dcms.Plugins.Forms.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Facebook\Dcms.Plugins.Facebook.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Instagram\Dcms.Plugins.Instagram.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Meta.Core\Dcms.Plugins.Meta.Core.csproj" />
