<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- TemplateMatcher, used by the edge route-table tests to match paths with the real
       ASP.NET route-template engine rather than a stand-in, and ApplicationBuilder, used to
       exercise the header-scrubbing middleware as it actually runs. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="JunitXml.TestLogger" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Audit\Dcms.Shared.Audit.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Data\Dcms.Shared.Data.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Kernel\Dcms.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Contracts\Dcms.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Media\Dcms.Shared.Media.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Security\Dcms.Shared.Security.csproj" />
    <!-- The platform console's purge guard is the one piece of that service worth testing in
         isolation: it is the thing standing between an operator and the audit evidence. -->
    <ProjectReference Include="..\..\src\Services\Dcms.PlatformApi\Dcms.PlatformApi.csproj" />
    <!-- The edge's route table is the whole public ingress expressed as data. Getting one
         Order or one path pattern wrong routes real traffic to the wrong service, so it is
         asserted here rather than discovered on the edge. -->
    <ProjectReference Include="..\..\src\Services\Dcms.Edge\Dcms.Edge.csproj" />
    <!-- The Anthropic ⇄ OpenAI translation. It is the reason the assistant works against any
         provider, it is pure input-to-output, and every mistake it can make is a shape the
         browser's agent loop then fails to parse — which is invisible until somebody's turn
         hangs. -->
    <ProjectReference Include="..\..\src\Services\Dcms.AiGateway\Dcms.AiGateway.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Messaging\Dcms.Shared.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Hosting\Dcms.Shared.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Telemetry\Dcms.Shared.Telemetry.csproj" />
  </ItemGroup>

</Project>
