<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="JunitXml.TestLogger" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="Testcontainers.Nats" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <!-- Not used directly: force the patched transitive versions. See Directory.Packages.props. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mounted into the test Postgres containers by TestPostgres. -->
    <None Include="..\..\infra\postgres\init\00-schemas.sql"
          Link="postgres-init\00-schemas.sql"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Dcms.AdminApi\Dcms.AdminApi.csproj" Aliases="AdminApiApp" />
    <ProjectReference Include="..\..\src\Services\Dcms.AiGateway\Dcms.AiGateway.csproj" Aliases="AiGatewayApp" />
    <ProjectReference Include="..\..\src\Services\Dcms.ContentApi\Dcms.ContentApi.csproj" />
    <ProjectReference Include="..\..\src\Services\Dcms.Edge\Dcms.Edge.csproj" Aliases="EdgeApp" />
    <ProjectReference Include="..\..\src\Services\Dcms.Identity\Dcms.Identity.csproj" Aliases="IdentityApp" />
    <ProjectReference Include="..\..\src\Services\Dcms.MediaWorker\Dcms.MediaWorker.csproj" Aliases="MediaWorkerApp" />
    <ProjectReference Include="..\..\src\Services\Dcms.PlatformApi\Dcms.PlatformApi.csproj" Aliases="PlatformApiApp" />
    <ProjectReference Include="..\..\src\Services\Dcms.SiteBuilder\Dcms.SiteBuilder.csproj" Aliases="SiteBuilderApp" />
    <ProjectReference Include="..\..\src\Services\Dcms.SiteHost\Dcms.SiteHost.csproj" Aliases="SiteHostApp" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Facebook\Dcms.Plugins.Facebook.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Instagram\Dcms.Plugins.Instagram.csproj" />
    <ProjectReference Include="..\..\src\Plugins\Dcms.Plugins.Meta.Core\Dcms.Plugins.Meta.Core.csproj" />
    <ProjectReference Include="..\..\src\Shared\Dcms.Shared.Media\Dcms.Shared.Media.csproj" />
  </ItemGroup>

  <!-- The Guestbook sample, installed the way an operator would (its build output in a folder of
       its own): the content-flow hosts load it through Plugins:Directory, so it runs against the
       real platform — routes, permissions, data sets, screens. -->
  <ItemGroup>
    <ProjectReference Include="..\..\samples\Dcms.Plugins.Sample.Guestbook\Dcms.Plugins.Sample.Guestbook.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="InstallSamplePlugin" AfterTargets="Build">
    <ItemGroup>
      <SamplePluginFiles Include="..\..\samples\Dcms.Plugins.Sample.Guestbook\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFiles)" DestinationFiles="@(SamplePluginFiles->'$(OutDir)installed-plugins\Dcms.Plugins.Sample.Guestbook\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
